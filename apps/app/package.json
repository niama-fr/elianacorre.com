{
  "name": "@ec/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite dev --port 3003",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "preview": "vite preview",
    "test": "bun run paraglide:compile && vitest run --config vitest.config.ts",
    "typecheck": "bun run paraglide:compile && tsc --noEmit"
  },
  "dependencies": {
    "@confect/core": "^10.0.0-next.17",
    "@confect/react": "^10.0.0-next.17",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/react-query": "^0.1.0",
    "@ec/backend": "workspace:*",
    "@ec/domain": "workspace:*",
    "@ec/http": "workspace:*",
    "@ec/ui": "workspace:*",
    "@ec/validation": "workspace:*",
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@iconify/json": "^2.2.519",
    "@iconify/tailwind4": "^1.2.3",
    "@inlang/paraglide-js": "^2.24.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-table": "^9.1.2",
    "better-auth": "1.6.29",
    "class-variance-authority": "^0.7.1",
    "convex": "1.45.0",
    "effect": "4.0.0-rc.110",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
