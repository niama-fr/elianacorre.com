{
  "name": "@ec/monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "oxfmt --check . && oxlint .",
    "delivery:report": "bun run scripts/report-client-javascript.ts",
    "dev": "turbo dev",
    "fix": "oxfmt --write . && oxlint --fix .",
    "test": "turbo test",
    "typecheck": "turbo typecheck && tsc --noEmit -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "ultracite": "7.10.5"
  },
  "packageManager": "bun@1.3.10"
}
